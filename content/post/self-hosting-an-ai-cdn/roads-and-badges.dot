digraph roads {
  graph [
    rankdir=TB, splines=spline, bgcolor="#1c1c1c",
    fontname="Helvetica", fontsize=12, pad=0.28, nodesep=0.5, ranksep=0.6,
    fontcolor="#e8e8e8"
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded",
        fillcolor="#2a2a2a", color="#5dba5d", fontcolor="#e8e8e8", margin="0.22,0.14"];
  edge [fontname="Helvetica", fontsize=10, color="#c8c8c8", fontcolor="#b8b8b8", arrowsize=0.7];

  you [
    label="you\nlaptop  ·  phone",
    fillcolor="#1e3a24", color="#5dba5d", penwidth=1.6
  ];
  ts [
    label="Tailscale  ·  the badge\nproves who you are",
    fillcolor="#2a2a2a", color="#5dba5d", penwidth=1.6
  ];

  subgraph cluster_roads {
    label="Cilium  ·  the roads";
    style="rounded,filled"; fillcolor="#222222"; color="#5dba5d"; fontsize=13; fontcolor="#e8e8e8";
    ot [label="Ottawa\nheadquarters"];
    rb [label="Robbinsdale\nthe house"];
    sp [label="St. Petersburg\nthe brain"];
    ot -> rb [dir=both];
    ot -> sp [dir=both];
    rb -> sp [dir=both];
  }

  you -> ts [label="log in"];
  ts -> ot [label="open a door"];
}
