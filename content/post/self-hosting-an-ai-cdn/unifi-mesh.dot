digraph unifi {
  graph [
    rankdir=LR, splines=spline, bgcolor="#1c1c1c",
    fontname="Helvetica", fontsize=12, pad=0.28, nodesep=0.4, ranksep=1.0,
    fontcolor="#e8e8e8"
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded",
        fillcolor="#2a2a2a", color="#5dba5d", fontcolor="#e8e8e8", margin="0.20,0.12"];
  edge [fontname="Helvetica", fontsize=10, color="#c8c8c8", fontcolor="#b8b8b8", arrowsize=0.7];

  subgraph cluster_unifi {
    label="UniFi site-to-site mesh  ·  the underlay";
    style="rounded,filled"; fillcolor="#222222"; color="#5dba5d"; fontsize=12; fontcolor="#e8e8e8";
    u_ot [label="Ottawa UDM"];
    u_rb [label="Robbinsdale UDM"];
    u_sp [label="St. Petersburg UDM"];
    u_ot -> u_rb [dir=both, label="L3"];
    u_ot -> u_sp [dir=both, label="L3"];
    u_rb -> u_sp [dir=both, label="L3"];
  }

  subgraph cluster_cilium {
    label="Cilium  ·  BGP + ClusterMesh";
    style="rounded,filled"; fillcolor="#1e3a24"; color="#5dba5d"; fontsize=12; fontcolor="#e8e8e8";
    c_ot [label="Ottawa\naddresses"];
    c_rb [label="Robbinsdale\naddresses"];
    c_sp [label="St. Petersburg\naddresses"];
    c_ot -> c_rb [dir=both, label="east-west"];
    c_ot -> c_sp [dir=both, label="east-west"];
    c_rb -> c_sp [dir=both, label="east-west"];
  }

  u_ot -> c_ot [label="BGP"];
  u_rb -> c_rb [label="BGP"];
  u_sp -> c_sp [label="BGP"];
}
