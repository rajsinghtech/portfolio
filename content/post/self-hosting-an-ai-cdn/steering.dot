digraph steering {
  graph [
    rankdir=LR, splines=spline, bgcolor="transparent",
    fontname="Helvetica", fontsize=12, pad=0.28, nodesep=0.45, ranksep=0.7,
    fontcolor="#e8e8e8"
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded",
        fillcolor="#2a2a2a", color="#5dba5d", fontcolor="#e8e8e8", margin="0.22,0.14"];
  edge [fontname="Helvetica", fontsize=10, color="#c8c8c8", fontcolor="#b8b8b8", arrowsize=0.7];

  client [label="client", fillcolor="#1e3a24", color="#5dba5d"];

  dns [
    label="DNS steering\nk8gb  ·  UniFi  ·  Cloudflare\npick a site"
  ];
  bgp [
    label="BGP steering\nCilium advertises addresses\npick a path",
    fillcolor="#1e3a24", color="#5dba5d"
  ];
  work [
    label="the workload\nschedule it where the\npath already is",
    color="#e8e8e8", penwidth=1.6
  ];

  client -> dns;
  dns -> bgp;
  bgp -> work;
}
