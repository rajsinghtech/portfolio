digraph factory {
  graph [
    rankdir=LR, splines=spline, bgcolor="#1c1c1c",
    fontname="Helvetica", fontsize=12, pad=0.28, nodesep=0.45, ranksep=0.7,
    fontcolor="#e8e8e8"
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded",
        fillcolor="#2a2a2a", color="#5dba5d", fontcolor="#e8e8e8", margin="0.22,0.14"];
  edge [fontname="Helvetica", fontsize=10, color="#c8c8c8", fontcolor="#b8b8b8", arrowsize=0.7];

  agent [label="agent\nwrites and runs code", fillcolor="#1e3a24", color="#5dba5d"];
  office [label="throwaway office\nits own tiny VM\nfire is contained"];
  git [label="git\nthe written company", color="#e8e8e8", penwidth=1.6];
  human [label="you\naccept the commit", fillcolor="#1e3a24", color="#5dba5d"];
  prod [label="production\nonly after the merge"];

  agent -> office [label="works here"];
  office -> git [label="opens a change"];
  git -> human [label="review"];
  human -> prod [label="merge"];
}
