digraph garage {
  graph [
    rankdir=TB, splines=spline, bgcolor="transparent",
    fontname="Helvetica", fontsize=13, pad=0.45, nodesep=0.7, ranksep=0.5,
    fontcolor="#e8e8e8", newrank=true
  ];
  node [fontname="Helvetica", fontsize=13, shape=box, style="filled,rounded",
        fillcolor="#2a2a2a", color="#5dba5d", fontcolor="#e8e8e8", margin="0.24,0.14"];
  edge [fontname="Helvetica", fontsize=11, color="#c8c8c8", fontcolor="#b8b8b8", arrowsize=0.7];

  git [
    label="git  ·  a merge is the layout",
    fillcolor="#1e3a24", color="#5dba5d", penwidth=1.8
  ];
  op [label="garage-operator"];
  git -> op;

  ot_app [label="Ottawa apps"];
  rb_app [label="Luke's apps"];
  sp_app [label="Karthik's apps"];
  { rank=same; ot_app; rb_app; sp_app; }

  ot_gw [label="Ottawa gateway"];
  rb_gw [label="Luke gateway"];
  sp_gw [label="Karthik gateway"];
  { rank=same; ot_gw; rb_gw; sp_gw; }

  ot_d [label="disks"];
  rb_d [label="disks"];
  sp_d [label="disks"];
  { rank=same; ot_d; rb_d; sp_d; }

  copies [
    label="three copies  ·  same hallway as the model",
    fillcolor="#1e3a24", color="#5dba5d", penwidth=1.8
  ];

  op -> ot_app;
  op -> rb_app;
  op -> sp_app;

  ot_app -> ot_gw [label="S3"];
  rb_app -> rb_gw [label="S3"];
  sp_app -> sp_gw [label="S3"];

  ot_gw -> ot_d;
  rb_gw -> rb_d;
  sp_gw -> sp_d;

  ot_d -> copies;
  rb_d -> copies;
  sp_d -> copies;
}
